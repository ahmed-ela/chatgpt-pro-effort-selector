{
  "manifest_version": 3,
  "name": "ChatGPT Pro Effort Selector",
  "version": "1.0.14",
  "description": "Adds a per-chat Standard or Extended thinking-effort selector beside ChatGPT Pro.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "debugger",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core/mode-core.js",
        "content/shadow-ui.js",
        "content/content-script.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
